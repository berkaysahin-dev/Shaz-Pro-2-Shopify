<section class="cinematic-banner-section" style="min-height: {{ section.settings.height }}vh;">
  <!-- Full-Bleed Media with Parallax -->
  <div class="cinematic-banner-media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        alt="{{ section.settings.heading | escape }}"
        data-parallax="true"
        data-parallax-speed="0.15"
        loading="lazy"
        width="2400"
        height="1200"
      >
    {%- else -%}
      <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #0B0C10 0%, #161922 100%); display: flex; align-items: center; justify-content: center; color: #334155;">
        <div style="width: 70%; height: 70%; opacity: 0.12;">
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        </div>
      </div>
    {%- endif -%}
  </div>

  <!-- Ambient Overlay -->
  <div class="cinematic-banner-overlay" style="background: {{ section.settings.overlay_color | default: '#0B0C10' }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <!-- Editorial Content (Centered) -->
  <div class="container" style="position: relative; z-index: 3; display: flex; justify-content: center; align-items: center; width: 100%; text-align: center;">
    <div class="cinematic-banner-content" data-reveal="fade-up" style="margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="badge" style="background: rgba(255,255,255,0.15); color: #FFFFFF; border: 1px solid rgba(255,255,255,0.3); align-self: center; margin: 0 auto;">
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}

      <h2 class="display-title" style="color: {{ section.settings.heading_color | default: '#FFFFFF' }}; font-size: clamp(2.5rem, 2rem + 3vw, 4.75rem); text-align: center; width: 100%;">
        {{ section.settings.heading | default: 'Saf Materyal. Sıfır Taviz.' }}
      </h2>

      <p style="color: {{ section.settings.subheading_color | default: 'rgba(255, 255, 255, 0.88)' }}; font-size: 1.125rem; line-height: 1.7; max-width: 620px; text-align: center; margin: 0 auto;">
        {{ section.settings.subheading | default: 'Her parça, ISO sertifikalı mikroskobik toleranslarla üretilerek onlarca yıllık günlük kullanımda bile formunu koruyan zamansız bir sanat eserine dönüşür.' }}
      </p>

      <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; align-items: center; margin-top: 0.5rem; width: 100%;">
        {%- if section.settings.cta_1_text != blank -%}
          <a href="{{ section.settings.cta_1_url | default: '/collections/all' }}" class="btn btn-white btn-lg">
            {{ section.settings.cta_1_text }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_2_text != blank -%}
          <a href="{{ section.settings.cta_2_url | default: '/pages/about' }}" class="btn btn-secondary btn-lg" style="color: #FFFFFF; border-color: rgba(255,255,255,0.35);">
            {{ section.settings.cta_2_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sinematik Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Arka Plan Görseli"
    },
    {
      "type": "range",
      "id": "height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Bölüm Yüksekliği",
      "default": 75
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Koyuluk Oranı (Overlay)",
      "default": 50
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Üst Rozet Metni",
      "default": "MONOLİTİK TASARIM FELSEFESİ"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Ana Başlık",
      "default": "Saf Materyal. Sıfır Taviz."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Alt Açıklama",
      "default": "Her parça, ISO sertifikalı mikroskobik toleranslarla üretilerek onlarca yıllık günlük kullanımda bile formunu koruyan zamansız bir sanat eserine dönüşür."
    },
    {
      "type": "text",
      "id": "cta_1_text",
      "label": "Birincil Buton Metni",
      "default": "Ürünü Keşfet & Satın Al"
    },
    {
      "type": "url",
      "id": "cta_1_url",
      "label": "Birincil Buton Linki"
    },
    {
      "type": "text",
      "id": "cta_2_text",
      "label": "İkincil Buton Metni",
      "default": "Tasarım Hikayesi"
    },
    {
      "type": "url",
      "id": "cta_2_url",
      "label": "İkincil Buton Linki"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Koyuluk / Katman Rengi",
      "default": "#0B0C10"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Başlık Rengi",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Alt Başlık Rengi",
      "default": "#E2E8F0"
    }
  ],
  "presets": [
    {
      "name": "Sinematik Banner"
    }
  ]
}
{% endschema %}
