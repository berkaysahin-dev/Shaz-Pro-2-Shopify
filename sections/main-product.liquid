{%- liquid
  if product == blank or product.title == blank
    assign product = collections.all.products.first
  endif
  if product == blank or product.title == blank
    assign product = all_products.first
  endif
  assign current_variant = product.selected_or_first_available_variant
  assign is_on_sale = false
  if current_variant and current_variant.compare_at_price > current_variant.price
    assign is_on_sale = true
    assign discount_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif
-%}

<section class="product-section" style="background-color: {{ section.settings.bg_color | default: 'var(--color-bg)' }}; color: {{ section.settings.text_color | default: 'var(--color-text)' }};" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
  <div class="container">
    <div class="product-grid">
      <!-- Media Gallery (Left Side) -->
      <div class="product-gallery">
        <!-- Thumbnails -->
        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbnails">
            {%- for media in product.media -%}
              <div
                class="product-gallery__thumb-item {% if forloop.first %}is-active{% endif %}"
                data-media-id="{{ media.id }}"
                data-media-src="{{ media | image_url: width: 1400 }}"
              >
                <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" loading="lazy" width="72" height="96">
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Main Media Preview -->
        <div class="product-gallery__main">
          <div class="product-gallery__main-image-wrap">
            {%- if product.featured_media -%}
              <img
                src="{{ product.featured_media | image_url: width: 1400 }}"
                alt="{{ product.featured_media.alt | escape | default: product.title }}"
                class="product-gallery__main-image"
                loading="eager"
                width="1400"
                height="1866"
              >
            {%- else -%}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--color-surface); color: var(--color-text-muted); min-height: 480px;">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Product Information & Purchase Form (Right Side) -->
      <div class="product-info">
        <!-- Vendor & Title -->
        <div>
          <div class="product-info__vendor">{{ product.vendor | default: shop.name | default: 'SHAZ PRO' }}</div>
          <h1 class="product-info__title">{{ product.title | default: 'Shaz Pro Spatial Titanium Stand' }}</h1>
        </div>

        <!-- Rating & Social Proof -->
        <div class="product-info__rating">
          <div style="display: flex; gap: 2px; color: #F59E0B;">
            {%- for star in (1..5) -%}
              {% render 'icon', icon: 'star' %}
            {%- endfor -%}
          </div>
          <span style="font-weight: 700; font-size: 13px; color: var(--color-text);">4.98</span>
          <span class="product-info__rating-count">(64 Doğrulanmış Müşteri Değerlendirmesi)</span>
        </div>

        <!-- Price Block -->
        <div class="product-info__price-block">
          <span class="product-info__price">{{ current_variant.price | default: 24000 | money }}</span>
          <span class="product-info__price--compare" style="{% unless is_on_sale %}display: none;{% endunless %}">
            {{ current_variant.compare_at_price | money }}
          </span>
          {%- if is_on_sale -%}
            <span class="product-info__savings-badge">-%{{ discount_percent }} İNDİRİM</span>
          {%- endif -%}
        </div>

        <!-- Free Worldwide Express Banner (Fully Color Customizable) -->
        <div style="background-color: {{ settings.pdp_shipping_badge_bg | default: '#F0FDF4' }}; border: 1px solid {{ settings.pdp_shipping_badge_border | default: '#BBF7D0' }}; color: {{ settings.pdp_shipping_badge_text | default: '#166534' }}; border-radius: var(--border-radius); padding: 0.75rem 1rem; display: flex; align-items: center; gap: 0.5rem; font-size: 12px; font-weight: 500;">
          <span style="display: flex; align-items: center; color: #16A34A;">{% render 'icon', icon: 'sparkle' %}</span>
          <span><strong>Aynı Gün Ücretsiz VIP Express Kargo</strong> bu ürün için tanımlandı.</span>
        </div>

        <!-- Scarcity Stock Indicator (Fully Color Customizable) -->
        {%- if settings.pdp_enable_live_stock -%}
          <div class="product-stock-urgency" style="color: {{ settings.pdp_stock_text_color | default: '#111827' }};">
            <div class="product-stock-urgency__header">
              <span class="product-stock-urgency__pulse" style="background-color: {{ settings.pdp_stock_pulse_color | default: '#E11D48' }}; box-shadow: 0 0 0 0 {{ settings.pdp_stock_pulse_color | default: '#E11D48' }}40;"></span>
              <span style="display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 600;">
                {% render 'icon', icon: 'zap' %}
                {{ 'products.product.only_left' | t: count: 4 | default: 'Stokta sadece 4 adet kaldı' }}
              </span>
            </div>
            <div class="product-stock-urgency__bar">
              <div class="product-stock-urgency__bar-fill" style="width: 25%; background-color: {{ settings.pdp_stock_pulse_color | default: 'var(--color-primary)' }};"></div>
            </div>
          </div>
        {%- endif -%}

        <!-- Real-Time Delivery Estimator -->
        {%- if settings.pdp_enable_delivery_estimator -%}
          <div class="product-delivery-estimator" data-delivery-timer>
            {% render 'icon', icon: 'clock' %}
            <div>
              <span>Kargoya veriliş için kalan süre: </span>
              <strong class="countdown-time" style="color: var(--color-primary);">02sa 35dk 18sn</strong>
              <span> &mdash; <strong>Yarın Sabah</strong> kargoda!</span>
            </div>
          </div>
        {%- endif -%}

        <!-- Product Purchase Form -->
        {% form 'product', product, id: 'MainProductForm', class: 'product-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          <!-- Variant Option Selectors -->
          {%- unless product.has_only_default_variant -%}
            <div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.5rem;">
              {%- for option in product.options_with_values -%}
                {%- assign downcase_name = option.name | downcase -%}
                {%- assign is_color = false -%}
                {%- if downcase_name == 'color' or downcase_name == 'colour' or downcase_name == 'renk' -%}
                  {%- assign is_color = true -%}
                {%- endif -%}

                <div class="product-option-group">
                  <div class="product-option-header">
                    <span class="product-option-label">
                      {{ option.name }}: <span class="product-option-selected-val text-muted" style="font-weight: 500;">{{ option.selected_value }}</span>
                    </span>
                    {%- if downcase_name == 'size' or downcase_name == 'beden' -%}
                      <button type="button" class="product-option-size-guide" data-open-size-guide>
                        {{ 'products.product.size_guide' | t | default: 'Size & Fit Guide' }}
                      </button>
                    {%- endif -%}
                  </div>

                  <div class="product-option-values">
                    {%- for value in option.values -%}
                      {%- if is_color -%}
                        {%- assign color_code = value | downcase | replace: ' ', '' -%}
                        <button
                          type="button"
                          class="product-pdp-swatch {% if option.selected_value == value %}is-selected{% endif %}"
                          style="background-color: {{ color_code }};"
                          data-value="{{ value | escape }}"
                          title="{{ value }}"
                          aria-label="{{ value }}"
                        ></button>
                      {%- else -%}
                        <button
                          type="button"
                          class="product-option-btn {% if option.selected_value == value %}is-selected{% endif %}"
                          data-value="{{ value | escape }}"
                        >
                          {{ value }}
                        </button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Quantity & Action Buttons -->
          <div class="product-actions-row">
            <div class="quantity-stepper">
              <button type="button" class="quantity-stepper__btn" onclick="const input = this.nextElementSibling; if(input.value > 1) input.value--;">-</button>
              <input type="number" name="quantity" value="1" min="1" class="quantity-stepper__input" aria-label="Quantity">
              <button type="button" class="quantity-stepper__btn" onclick="const input = this.previousElementSibling; input.value++;">+</button>
            </div>

            <button
              type="submit"
              name="add"
              class="btn btn-primary product-atc-btn"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t | default: 'Sepete Ekle' }}
              {%- else -%}
                {{ 'products.product.sold_out' | t | default: 'Tükendi' }}
              {%- endif -%}
            </button>

            <!-- Wishlist Button -->
            <button
              type="button"
              class="btn btn-secondary"
              data-wishlist-btn
              data-product-handle="{{ product.handle }}"
              style="width: 50px; padding: 0;"
              aria-label="{{ 'products.wishlist.add' | t | default: 'Favorilere Ekle' }}"
            >
              {% render 'icon', icon: 'heart' %}
            </button>
          </div>

          <!-- Dynamic Checkout Button -->
          <div style="margin-top: 0.75rem;">
            {{ form | payment_button }}
          </div>
        {% endform %}

        <!-- Trust Signals Row -->
        {%- if settings.pdp_enable_trust_badges -%}
          <div class="product-trust-badges">
            <div class="product-trust-item">
              {% render 'icon', icon: 'shield-check' %}
              <span>{{ 'products.product.trust_secure' | t | default: '256-Bit SSL Güvenli Ödeme' }}</span>
            </div>
            <div class="product-trust-item">
              {% render 'icon', icon: 'truck' %}
              <span>{{ 'products.product.trust_shipping' | t | default: 'Aynı Gün VIP Express Kargo' }}</span>
            </div>
            <div class="product-trust-item">
              {% render 'icon', icon: 'rotate-ccw' %}
              <span>{{ 'products.product.trust_returns' | t | default: '30 Gün Koşulsuz İade' }}</span>
            </div>
            <div class="product-trust-item">
              {% render 'icon', icon: 'award' %}
              <span>{{ 'products.product.trust_warranty' | t | default: '2 Yıl Resmi Garanti' }}</span>
            </div>
          </div>
        {%- endif -%}

        <!-- Information Accordions -->
        <div class="product-accordions" data-accordion-type="multiple">
          <!-- Description / Details -->
          <div class="product-accordion-item is-open">
            <div class="product-accordion-header">
              <span>{{ 'products.product.details' | t | default: 'Mimari Detaylar & Teknik Özellikler' }}</span>
              <span class="product-accordion-icon">{% render 'icon', icon: 'chevron-down' %}</span>
            </div>
            <div class="product-accordion-body">
              {%- if product.description != blank -%}
                {{ product.description }}
              {%- else -%}
                <p>Havacılık sınıfı 5. seviye yekpare titanyum bloktan 0.02 mm mikroskobik toleransla üretilmiştir. Entegre akustik izolasyon silikon pedleri ve neodimyum manyetik kilit hizalamasına sahiptir.</p>
              {%- endif -%}
            </div>
          </div>

          <!-- Materials & Care -->
          <div class="product-accordion-item">
            <div class="product-accordion-header">
              <span>{{ 'products.product.materials_care' | t | default: 'Metalurji & Bakım Rehberi' }}</span>
              <span class="product-accordion-icon">{% render 'icon', icon: 'chevron-down' %}</span>
            </div>
            <div class="product-accordion-body">
              <p>Tek parça Grade 5 Ti-6Al-4V titanyum külçeden hassas olarak işlenmiştir. İpeksi mikroskobik mat doku için özel olarak saten el polisajı yapılmıştır. Parlaklığını korumak için mikrofiber bezle nazikçe siliniz. Aşındırıcı kimyasal çözücülerden kaçınınız.</p>
            </div>
          </div>

          <!-- Shipping & Returns -->
          <div class="product-accordion-item">
            <div class="product-accordion-header">
              <span>{{ 'products.product.shipping_returns' | t | default: 'Ücretsiz Express Teslimat & İade' }}</span>
              <span class="product-accordion-icon">{% render 'icon', icon: 'chevron-down' %}</span>
            </div>
            <div class="product-accordion-body">
              <p>Tüm siparişler 24 saat içinde VIP Express Kargo ile özenle paketlenip yola çıkar. 1-3 iş günü içinde adresinize teslim edilir. 30 gün boyunca koşulsuz deneme ve ücretsiz iade garantisi bulunmaktadır.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sticky Add to Cart Bar -->
  {%- if settings.pdp_enable_sticky_atc -%}
    <div class="sticky-atc-bar" aria-hidden="true">
      <div class="container sticky-atc-bar__container">
        <div class="sticky-atc-bar__product">
          {%- if product.featured_media -%}
            <img src="{{ product.featured_media | image_url: width: 90 }}" alt="{{ product.title }}" class="sticky-atc-bar__thumb" loading="lazy">
          {%- endif -%}
          <div>
            <div class="sticky-atc-bar__title">{{ product.title | default: 'Shaz Pro Spatial Titanyum Stand' }}</div>
            <div class="sticky-atc-bar__price text-muted">{{ current_variant.price | default: 24000 | money }}</div>
          </div>
        </div>
        <div>
          <button type="button" class="btn btn-primary btn-sm sticky-atc-btn" onclick="document.querySelector('.product-atc-btn').click();">
            {{ 'products.product.add_to_cart' | t | default: 'Sepete Ekle' }}
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

<!-- Inject Product JSON for dynamic JS variant handler -->
<script>
  window.productVariants = {{ product.variants | json }};
</script>

{% schema %}
{
  "name": "Ürün Bilgileri",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Metin Rengi",
      "default": "#0B0C10"
    },
    {
      "type": "text",
      "id": "vendor_fallback",
      "label": "Marka İsmi (Boşsa)",
      "default": "SHAZ PRO"
    },
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Stok Sayacı Göster",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Stok Uyarısı Metni",
      "default": "Stokta sadece 4 adet kaldı — Seri Numaralı Özel Üretim"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_badge",
      "label": "VIP Kargo Rozetini Göster",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Güvenilirlik Rozetlerini Göster",
      "default": true
    }
  ]
}
{% endschema %}
