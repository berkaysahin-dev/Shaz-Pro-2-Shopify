<section class="section-spacing">
  <div class="container-narrow">
    <div style="margin-bottom: var(--space-lg); text-align: center;" data-reveal="fade-up">
      <h1 class="display-title">{{ page.title | default: 'Hakkımızda' }}</h1>
    </div>

    {%- if page.content != blank -%}
      <div style="font-size: 1.0625rem; line-height: 1.8; color: var(--color-text);" data-reveal="fade-up">
        {{ page.content }}
      </div>
    {%- endif -%}

    {%- assign page_handle_lower = page.handle | downcase -%}

    {%- comment -%}
      Auto-detect About page and render luxury editorial brand story
    {%- endcomment -%}
    {%- if page_handle_lower contains 'about' or page_handle_lower contains 'hakkimizda' or page_handle_lower contains 'hikayemiz' or page_handle_lower contains 'story' -%}
      <div style="margin-top: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-2xl);">
        <!-- Hero Editorial Quote -->
        <div style="background: var(--color-surface); padding: clamp(2rem, 5vw, 4rem); border-radius: var(--border-radius-lg); border: 1px solid var(--color-border); text-align: center;" data-reveal="fade-up">
          <span class="text-uppercase text-accent" style="letter-spacing: 0.15em; font-weight: 700;">Tasarım Manifestosu</span>
          <p style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.75rem); line-height: 1.5; font-style: italic; color: var(--color-text); margin: 1.5rem auto; max-width: 720px;">
            "Dijital bilgi işlemeyi dokunsal, heykelsi bir ritüele dönüştüren, yüzeysel gürültüyü ortadan kaldıran mekânsal nesneler tasarlıyoruz."
          </p>
          <span style="font-size: 13px; color: var(--color-text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em;">Shaz Agency Stüdyo</span>
        </div>

        <!-- Editorial Split -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; align-items: center;" data-reveal="fade-up">
          <div style="border-radius: var(--border-radius-lg); overflow: hidden; aspect-ratio: 4/5; background: #16181F; display: flex; align-items: center; justify-content: center; color: #475569; padding: 2rem;">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <span class="section-subtitle">Tasarım Mirası</span>
            <h2 class="h2">Mimarlık ve Metalürjinin Kesişiminde Doğdu</h2>
            <p style="color: var(--color-text-muted); font-size: 1.0625rem; line-height: 1.8;">
              Saf malzemelere ve mikro toleranslara adanmış bir taahhütle kurulan Shaz Agency, mekânsal bilgisayar donanımlarını klasik heykel sanatının saygınlığıyla ele alan aksesuarlar ve ayaklar tasarlar.
            </p>
            <p style="color: var(--color-text-muted); font-size: 1.0625rem; line-height: 1.8;">
              Her kavis, pah ve manyetik bağlantı noktası yekpare 5. Seviye titanyum bloktan işlenir, sınırlı sayıda numaralı edisyonlar halinde el işçiliğiyle cilalanır.
            </p>
          </div>
        </div>

        <!-- 3 Pillars Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2rem;" data-reveal="fade-up">
          <div style="background: var(--color-surface); padding: 2.25rem 2rem; border-radius: var(--border-radius); border: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 1rem;">
            <span style="font-size: 1.5rem; font-weight: 700; color: var(--color-secondary);">01</span>
            <h3 style="font-size: 1.25rem;">5. Seviye Titanyum</h3>
            <p style="color: var(--color-text-muted); font-size: 14px; line-height: 1.7;">
              Havacılık sınıfı Ti-6Al-4V alaşımı; benzersiz yapısal mukavemet, hipoalerjenik temas ve zamansız dayanıklılık sunar.
            </p>
          </div>
          <div style="background: var(--color-surface); padding: 2.25rem 2rem; border-radius: var(--border-radius); border: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 1rem;">
            <span style="font-size: 1.5rem; font-weight: 700; color: var(--color-secondary);">02</span>
            <h3 style="font-size: 1.25rem;">0.02mm Toleranslar</h3>
            <p style="color: var(--color-text-muted); font-size: 14px; line-height: 1.7;">
              Çok eksenli yüksek hızlı CNC frezeleme; her dikişsiz ek, birleşim ve manyetik yuvada mikroskobik hassasiyet sağlar.
            </p>
          </div>
          <div style="background: var(--color-surface); padding: 2.25rem 2rem; border-radius: var(--border-radius); border: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 1rem;">
            <span style="font-size: 1.5rem; font-weight: 700; color: var(--color-secondary);">03</span>
            <h3 style="font-size: 1.25rem;">El İşçiliği Saten</h3>
            <p style="color: var(--color-text-muted); font-size: 14px; line-height: 1.7;">
              Her bitmiş parça Milano'da usta zanaatkârlar tarafından el ile cilalanır ve saten anodize edilerek ortam ışığını yumuşak bir mat parıltıyla yansıtır.
            </p>
          </div>
        </div>

        <!-- CTA Box -->
        <div style="background: #0B0C10; color: #FFFFFF; padding: clamp(2.5rem, 5vw, 4.5rem); border-radius: var(--border-radius-lg); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem;" data-reveal="fade-up">
          <h2 class="h2" style="color: #FFFFFF;">Shaz Agency Koleksiyonunu Keşfedin</h2>
          <p style="color: #94A3B8; font-size: 1.0625rem; max-width: 560px; line-height: 1.7;">
            Hassas ayaklar, mekânsal bilgisayar aksesuarları ve monolitik masaüstü serimizi keşfedin.
          </p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-white btn-lg">
            Koleksiyonu Keşfet →
          </a>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}
      Auto-detect contact pages by handle and show contact form
    {%- endcomment -%}
    {%- if page_handle_lower contains 'contact' or page_handle_lower contains 'iletisim' or page_handle_lower contains 'bize-ulasin' -%}
      <div style="margin-top: var(--space-xl);" data-reveal="fade-up">
        <div style="background: var(--color-surface); padding: clamp(2rem, 4vw, 3.5rem); border-radius: var(--border-radius-lg); border: 1px solid var(--color-border);">
          {% form 'contact' %}
            {%- if form.posted_successfully? -%}
              <div style="color: var(--color-stock-success); font-weight: 600; font-size: 1.125rem; text-align: center; padding: 2rem 0;">
                Mesajınız için teşekkür ederiz. Ekibimiz 24 saat içinde yanıt verecektir.
              </div>
            {%- else -%}
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div class="form-group">
                  <label class="form-label" for="ContactFormName">İsim</label>
                  <input type="text" name="contact[name]" id="ContactFormName" class="form-input" placeholder="Adınız" required>
                </div>
                <div class="form-group">
                  <label class="form-label" for="ContactFormEmail">E-posta Adresi</label>
                  <input type="email" name="contact[email]" id="ContactFormEmail" class="form-input" placeholder="email@domain.com" required>
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="ContactFormInquiry">Konu</label>
                <select name="contact[inquiry_type]" id="ContactFormInquiry" class="form-select">
                  <option value="General Inquiry">Genel Müşteri Desteği</option>
                  <option value="Order & Logistics">Sipariş & Kargo</option>
                  <option value="Product Question">Özel Sipariş / Toplu Satış</option>
                  <option value="Press & Media">Basın & Medya</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="ContactFormMessage">Mesaj</label>
                <textarea name="contact[body]" id="ContactFormMessage" rows="5" class="form-textarea" placeholder="Size nasıl yardımcı olabiliriz?" required></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top: 1rem;">
                Mesajı Gönder
              </button>
            {%- endif -%}
          {% endform %}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sayfa İçeriği",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Arka Plan Rengi", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Metin Rengi", "default": "#0B0C10" },
    { "type": "color", "id": "accent_color", "label": "Vurgu Rengi", "default": "#6366F1" },
    { "type": "color", "id": "cta_bg_color", "label": "CTA Arka Plan Rengi", "default": "#0B0C10" },
    { "type": "color", "id": "cta_text_color", "label": "CTA Metin Rengi", "default": "#FFFFFF" }
  ]
}
{% endschema %}
