<footer class="footer-wrapper" style="background-color: #07080A; color: #FFFFFF; padding: clamp(2.5rem, 4vw, 4rem) 0 var(--space-lg); border-top: 1px solid rgba(255, 255, 255, 0.08);">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 3rem; margin-bottom: var(--space-2xl);">
      <!-- Brand Manifesto -->
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <h3 style="font-size: 1.5rem; letter-spacing: 0.06em; text-transform: uppercase; color: #FFFFFF;">
          {{ shop.name | default: 'SHAZ PRO' }}
        </h3>
        <p style="color: #94A3B8; font-size: 14px; line-height: 1.7; max-width: 320px;">
          {{ section.settings.brand_text | default: 'Titizlikle tasarlanmış mekânsal ve teknolojik donanımlar. Yalın mimari estetik, saf metalurji ve zamansız fonksiyonel tasarım ilkeleriyle geliştirildi.' }}
        </p>
        <div style="display: flex; gap: 1rem; color: #94A3B8; font-size: 13px;">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" style="color: inherit;">Instagram</a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" style="color: inherit;">X / Twitter</a>
          {%- endif -%}
        </div>
      </div>

      <!-- Navigation Columns (Blocks) -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div {{ block.shopify_attributes }} style="display: flex; flex-direction: column; gap: 1rem;">
              <h4 style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #64748B;">
                {{ block.settings.title | default: linklists[block.settings.menu].title }}
              </h4>
              <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem;">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li>
                    <a href="{{ link.url }}" style="font-size: 14px; color: #CBD5E1; transition: color var(--transition-fast);">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }} style="display: flex; flex-direction: column; gap: 1rem;">
              <h4 style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #64748B;">
                {{ block.settings.title | default: 'Özel Bülten' }}
              </h4>
              <p style="color: #94A3B8; font-size: 14px; line-height: 1.6;">
                {{ block.settings.subtext | default: 'Lansman duyuruları, özel fırsatlar ve ürün ön gösterimleri için kaydolun.' }}
              </p>
              {% form 'customer', class: 'footer-newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div style="display: flex; gap: 0.5rem;">
                  <input
                    type="email"
                    name="contact[email]"
                    class="form-input"
                    placeholder="E-posta adresinizi girin"
                    style="background: #14171F; border-color: #242936; color: #FFFFFF; font-size: 13px;"
                    required
                  >
                  <button type="submit" class="btn btn-white btn-sm">Kayıt Ol</button>
                </div>
              {% endform %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Bottom Bar with Shaz Vision Signature -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; padding-top: 2rem; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 12px; color: #64748B;">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Shaz Pro' }}. Tüm Hakları Saklıdır. Tasarım &amp; Geliştirme: <a href="https://shazvision.com" target="_blank" rel="noopener" style="color: #CBD5E1; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; transition: color var(--transition-fast);">Shaz Vision</a>.
      </div>
      <div style="display: flex; gap: 1.5rem; align-items: center;">
        <span style="display: inline-flex; align-items: center; gap: 0.4rem;">
          {% render 'icon', icon: 'lock' %}
          256-Bit SSL Güvenli Ödeme
        </span>
        <span style="display: inline-flex; align-items: center; gap: 0.4rem;">
          {% render 'icon', icon: 'globe' %}
          Karbon Nötr Hızlı Kargo
        </span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Alt Bilgi (Footer)",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Marka Açıklaması",
      "default": "Titizlikle tasarlanmış mekânsal ve teknolojik donanımlar. Yalın mimari estetik, saf metalurji ve zamansız fonksiyonel tasarım ilkeleriyle geliştirildi."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menü Sütunu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Sütun Başlığı",
          "default": "Koleksiyon"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menü Seç",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Bülten Bloğu",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Başlık",
          "default": "Özel Bülten"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Alt Metin",
          "default": "Lansman duyuruları, özel fırsatlar ve ürün ön gösterimleri için kaydolun."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list",
        "settings": { "title": "Ürünler" }
      },
      {
        "type": "link_list",
        "settings": { "title": "Müşteri Hizmetleri" }
      },
      {
        "type": "newsletter",
        "settings": {}
      }
    ]
  }
}
{% endschema %}
