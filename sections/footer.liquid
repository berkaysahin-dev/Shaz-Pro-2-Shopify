{%- if section.settings.show_animated_divider -%}
  <div class="footer-animated-divider" style="overflow: hidden; line-height: 0; background: transparent; width: 100%;">
    <style>
      .footer-animated-divider .parallax1 > use { animation: move-forever1 10s linear infinite; }
      .footer-animated-divider .parallax2 > use { animation: move-forever2 8s linear infinite; opacity: 0.5; }
      .footer-animated-divider .parallax3 > use { animation: move-forever3 6s linear infinite; opacity: 0.3; }
      .footer-animated-divider .parallax4 > use { animation: move-forever4 4s linear infinite; opacity: 0.15; }
      @keyframes move-forever1 { 0% { transform: translate(85px, 0%); } 100% { transform: translate(-90px, 0%); } }
      @keyframes move-forever2 { 0% { transform: translate(-90px, 0%); } 100% { transform: translate(85px, 0%); } }
      @keyframes move-forever3 { 0% { transform: translate(85px, 0%); } 100% { transform: translate(-90px, 0%); } }
      @keyframes move-forever4 { 0% { transform: translate(-90px, 0%); } 100% { transform: translate(85px, 0%); } }
    </style>
    <svg class="waves-animated-1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 24 150 28" preserveAspectRatio="none" style="display: block; width: 100%; height: clamp(40px, 5vw, 75px); transform: translateY(1px);">
      <defs>
        <path id="gentle-wave-footer" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
      </defs>
      <g class="parallax1"><use xlink:href="#gentle-wave-footer" x="50" y="3" fill="{{ section.settings.divider_fill | default: '#07080A' }}"/></g>
      <g class="parallax2"><use xlink:href="#gentle-wave-footer" x="50" y="0" fill="{{ section.settings.divider_fill | default: '#07080A' }}"/></g>
      <g class="parallax3"><use xlink:href="#gentle-wave-footer" x="50" y="9" fill="{{ section.settings.divider_fill | default: '#07080A' }}"/></g>
      <g class="parallax4"><use xlink:href="#gentle-wave-footer" x="50" y="6" fill="{{ section.settings.divider_fill | default: '#07080A' }}"/></g>
    </svg>
  </div>
{%- endif -%}

<footer class="footer-wrapper" style="background-color: {{ section.settings.bg_color | default: '#07080A' }}; color: {{ section.settings.text_color | default: '#FFFFFF' }}; padding: clamp(2.5rem, 4vw, 4rem) 0 var(--space-lg); border-top: 1px solid rgba(255, 255, 255, 0.08);">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 3rem; margin-bottom: var(--space-2xl);">
      <!-- Brand Manifesto -->
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <h3 style="font-size: 1.5rem; letter-spacing: 0.06em; text-transform: uppercase; color: #FFFFFF;">
          {{ shop.name | default: 'SHAZ AGENCY' }}
        </h3>
        <p style="color: #94A3B8; font-size: 14px; line-height: 1.7; max-width: 320px;">
          {{ section.settings.brand_text | default: 'Titizlikle tasarlanmış mekânsal ve teknolojik donanımlar. Yalın mimari estetik, saf metalurji ve zamansız fonksiyonel tasarım ilkeleriyle geliştirildi.' }}
        </p>
        <div style="display: flex; gap: 1rem; color: #94A3B8; font-size: 13px;">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" style="color: inherit;">Instagram</a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" style="color: inherit;">X / Twitter</a>
          {%- endif -%}
        </div>
      </div>

      <!-- Navigation Columns (Blocks) -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div {{ block.shopify_attributes }} style="display: flex; flex-direction: column; gap: 1rem;">
              <h4 style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #64748B;">
                {{ block.settings.title | default: linklists[block.settings.menu].title }}
              </h4>
              <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem;">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li>
                    <a href="{{ link.url }}" style="font-size: 14px; color: #CBD5E1; transition: color var(--transition-fast);">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }} style="display: flex; flex-direction: column; gap: 1rem;">
              <h4 style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #64748B;">
                {{ block.settings.title | default: 'Özel Bülten' }}
              </h4>
              <p style="color: #94A3B8; font-size: 14px; line-height: 1.6;">
                {{ block.settings.subtext | default: 'Lansman duyuruları, özel fırsatlar ve ürün ön gösterimleri için kaydolun.' }}
              </p>
              {% form 'customer', class: 'footer-newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div style="display: flex; gap: 0.5rem;">
                  <input
                    type="email"
                    name="contact[email]"
                    class="form-input"
                    placeholder="E-posta adresinizi girin"
                    style="background: #14171F; border-color: #242936; color: #FFFFFF; font-size: 13px;"
                    required
                  >
                  <button type="submit" class="btn btn-white btn-sm">Kayıt Ol</button>
                </div>
              {% endform %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Bottom Bar with Shaz Agency Signature -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; padding-top: 2rem; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 12px; color: #64748B;">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Shaz Agency' }}. Tüm Hakları Saklıdır. Tasarım &amp; Geliştirme: <a href="https://shazagency.com" target="_blank" rel="noopener" style="color: #CBD5E1; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; transition: color var(--transition-fast);">Shaz Agency</a>.
      </div>
      <div style="display: flex; gap: 1.5rem; align-items: center;">
        <span style="display: inline-flex; align-items: center; gap: 0.4rem;">
          {% render 'icon', icon: 'lock' %}
          256-Bit SSL Güvenli Ödeme
        </span>
        <span style="display: inline-flex; align-items: center; gap: 0.4rem;">
          {% render 'icon', icon: 'globe' %}
          Karbon Nötr Hızlı Kargo
        </span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Alt Bilgi (Footer)",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_animated_divider",
      "label": "Hareketli Dalga Ayırıcıyı Göster",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_fill",
      "label": "Dalga Rengi",
      "default": "#07080A"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Footer Arka Plan Rengi",
      "default": "#07080A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Footer Metin Rengi",
      "default": "#FFFFFF"
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Marka Açıklaması",
      "default": "Titizlikle tasarlanmış mekânsal ve teknolojik donanımlar. Yalın mimari estetik, saf metalurji ve zamansız fonksiyonel tasarım ilkeleriyle geliştirildi."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menü Sütunu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Sütun Başlığı",
          "default": "Koleksiyon"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menü Seç",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Bülten Bloğu",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Başlık",
          "default": "Özel Bülten"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Alt Metin",
          "default": "Lansman duyuruları, özel fırsatlar ve ürün ön gösterimleri için kaydolun."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list",
        "settings": { "title": "Ürünler" }
      },
      {
        "type": "link_list",
        "settings": { "title": "Müşteri Hizmetleri" }
      },
      {
        "type": "newsletter",
        "settings": {}
      }
    ]
  }
}
{% endschema %}
