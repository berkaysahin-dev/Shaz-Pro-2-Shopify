<section class="sticky-story-section" style="background-color: {{ section.settings.bg_color | default: 'var(--color-bg)' }}; color: {{ section.settings.text_color | default: 'var(--color-text)' }};">
  <div class="container">
    <div class="sticky-story-grid">
      <!-- Sticky Media Left Column -->
      <div class="sticky-story-media-pane">
        {%- for block in section.blocks -%}
          <div
            class="sticky-story-media-img {% if forloop.first %}is-active{% endif %}"
            data-step-index="{{ forloop.index }}"
            style="width: 100%; height: 100%;"
          >
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1200 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- else -%}
              <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(135deg, #11141A 0%, #1A1F2B 100%); color: #64748B; padding: 2rem; text-align: center; border-radius: var(--border-radius-lg); border: 1px solid rgba(255, 255, 255, 0.08);">
                <span style="font-size: 3rem; font-weight: 800; color: var(--color-secondary); opacity: 0.6; margin-bottom: 0.5rem;">{{ block.settings.chapter_num | default: forloop.index }}</span>
                <span style="font-size: 0.875rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: #FFFFFF;">{{ block.settings.chapter_title | default: 'AŞAMA' }}</span>
                <span style="font-size: 0.75rem; color: #94A3B8; margin-top: 0.5rem;">{{ block.settings.title }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <!-- Scrolling Content Steps Right Column -->
      <div class="sticky-story-steps-pane">
        {%- for block in section.blocks -%}
          <div class="sticky-story-step" data-step-index="{{ forloop.index }}" data-reveal="fade-up" {{ block.shopify_attributes }}>
            <span class="sticky-story-counter">{{ block.settings.chapter_num | default: '01' }} &mdash; {{ block.settings.chapter_title | default: 'AŞAMA' }}</span>
            <h3 class="sticky-story-title">{{ block.settings.title }}</h3>
            <p class="sticky-story-desc">{{ block.settings.description }}</p>
            {%- if block.settings.cta_text != blank -%}
              <div style="margin-top: 0.5rem;">
                <a href="{{ block.settings.cta_url | default: '/collections/all' }}" class="btn btn-secondary" style="color: #FFFFFF; border-color: rgba(255,255,255,0.3);">
                  {{ block.settings.cta_text }} →
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sabit Görselli Hikaye",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Metin Rengi",
      "default": "#0B0C10"
    }
  ],
  "blocks": [
    {
      "type": "story_chapter",
      "name": "Hikaye Bölümü",
      "settings": [
        {
          "type": "text",
          "id": "chapter_num",
          "label": "Bölüm Numarası",
          "default": "01"
        },
        {
          "type": "text",
          "id": "chapter_title",
          "label": "Bölüm Etiketi",
          "default": "TASARIM"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Başlık",
          "default": "Mimari Geometri ve Ergonomi"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Açıklama",
          "default": "Gereksiz her türlü süslemeyi eledik. Her açı ve kavis, insan elinin ve donanımın en doğal dinlenme pozisyonuna göre şekillendirildi."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bölüm Görseli"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Buton Metni",
          "default": "Tasarım Detaylarını Keşfet"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Buton Linki"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sabit Görselli Hikaye",
      "blocks": [
        {
          "type": "story_chapter",
          "settings": {
            "chapter_num": "01",
            "chapter_title": "TASARIM",
            "title": "Mimari Geometri ve Ergonomi",
            "description": "Gereksiz her türlü süslemeyi eledik. Her açı ve kavis, insan elinin ve donanımın en doğal dinlenme pozisyonuna göre şekillendirildi."
          }
        },
        {
          "type": "story_chapter",
          "settings": {
            "chapter_num": "02",
            "chapter_title": "MALZEME",
            "title": "Havacılık Sınıfı 5. Seviye Titanyum",
            "description": "Eşsiz mukavemet-ağırlık oranı ve hipoalerjenik özellikleri nedeniyle seçildi. 0.02 mm mikroskobik toleransla hassas olarak işlendi."
          }
        },
        {
          "type": "story_chapter",
          "settings": {
            "chapter_num": "03",
            "chapter_title": "İŞÇİLİK",
            "title": "Çok Aşamalı El Polisajı & Saten Anodizasyon",
            "description": "Her yüzey, ortam ışığını zarifçe yansıtan ipeksi mat bir doku elde etmek için dört aşamalı mikroskobik el işçiliğinden geçer."
          }
        },
        {
          "type": "story_chapter",
          "settings": {
            "chapter_num": "04",
            "chapter_title": "DENEYİM",
            "title": "Masaüstü İçin Manyetik ve Akustik Denge",
            "description": "Entegre neodimyum manyetik kilit ve titreşim engelleyici akustik silikon pedlerle sıfır sürtünme ve tam denge sağlar."
          }
        }
      ]
    }
  ]
}
{% endschema %}
