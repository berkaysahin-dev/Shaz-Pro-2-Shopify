{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="container">
      <div class="announcement-bar__item">
        <span>{{ section.settings.text }}</span>
        {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
          <a href="{{ section.settings.link_url }}">{{ section.settings.link_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Duyuru Çubuğu",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Duyuru Çubuğunu Göster",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Duyuru Metni",
      "default": "Tüm Siparişlerde Aynı Gün Ücretsiz VIP Express Kargo"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Bağlantı Metni",
      "default": "Hemen İncele"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Bağlantı Adresi"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#0F1115"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Yazı Rengi",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
