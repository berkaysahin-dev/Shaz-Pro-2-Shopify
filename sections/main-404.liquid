<section class="section-spacing" style="min-height: 60vh; display: flex; align-items: center;">
  <div class="container-narrow" style="text-align: center; display: flex; flex-direction: column; gap: 1.5rem; align-items: center;">
    <span class="text-uppercase text-muted">Error 404</span>
    <h1 class="display-title">Sayfa Bulunamadı</h1>
    <p style="color: var(--color-text-muted); font-size: 1.125rem; max-width: 480px;">
      Aradığınız sayfa taşınmış veya artık mevcut değil.
    </p>
    <div style="display: flex; gap: 1rem; margin-top: 1rem;">
      <a href="{{ routes.root_url }}" class="btn btn-primary">Ana Sayfaya Dön</a>
      <a href="/collections/all" class="btn btn-secondary">Ürünleri Keşfet</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Sayfası",
  "settings": [
    { "type": "text", "id": "title", "label": "Başlık", "default": "Sayfa Bulunamadı" },
    { "type": "textarea", "id": "description", "label": "Açıklama", "default": "Aradığınız sayfa taşınmış veya artık mevcut değil." },
    { "type": "text", "id": "home_btn", "label": "Ana Sayfa Butonu", "default": "Ana Sayfaya Dön" },
    { "type": "text", "id": "catalog_btn", "label": "Katalog Butonu", "default": "Ürünleri Keşfet" },
    { "type": "color", "id": "bg_color", "label": "Arka Plan Rengi", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Metin Rengi", "default": "#0B0C10" },
    { "type": "color", "id": "btn_bg_color", "label": "Buton Arka Plan Rengi", "default": "#0B0C10" },
    { "type": "color", "id": "btn_text_color", "label": "Buton Metin Rengi", "default": "#FFFFFF" }
  ]
}
{% endschema %}
