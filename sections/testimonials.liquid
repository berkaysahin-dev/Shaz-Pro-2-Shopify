<section class="section-spacing" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="section-header text-center">
      {%- if section.settings.subtitle != blank -%}
        <div class="section-subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      <h2 class="h2">{{ section.settings.title | default: 'Tasarımcılar ve Patronlar Tarafından Onaylandı' }}</h2>
    </div>

    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars">
            {%- for star in (1..5) -%}
              {% render 'icon', icon: 'star' %}
            {%- endfor -%}
          </div>
          <p class="testimonial-card__quote">
            "{{ block.settings.quote | default: 'Titanyum standın ağırlığı, mikron hassasiyeti ve dokunsal hissi bugüne kadar sahip olduğum tüm aksesuarların çok ötesinde. Masamda adeta mimari bir heykel gibi duruyor.' }}"
          </p>
          <div class="testimonial-card__author">
            <div>
              <div class="testimonial-card__name">{{ block.settings.author | default: 'Caner V.' }}</div>
              <div class="text-muted" style="font-size: 11px;">{{ block.settings.role | default: 'Endüstriyel Tasarımcı, İstanbul' }}</div>
            </div>
            {%- if block.settings.verified -%}
              <div class="testimonial-card__verified">
                {% render 'icon', icon: 'shield-check' %}
                <span>Doğrulanmış Müşteri</span>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Müşteri Yorumları",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Alt Başlık",
      "default": "Kullanıcı Deneyimleri"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Başlık",
      "default": "Tasarımcılar ve Patronlar Tarafından Onaylandı"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Yorum Kartı",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Kullanıcı Yorumu",
          "default": "Titanyum standın ağırlığı, mikron hassasiyeti ve dokunsal hissi bugüne kadar sahip olduğum tüm aksesuarların çok ötesinde. Masamda adeta mimari bir heykel gibi duruyor."
        },
        {
          "type": "text",
          "id": "author",
          "label": "İsim",
          "default": "Caner V."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Unvan / Şehir",
          "default": "Endüstriyel Tasarımcı, İstanbul"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Doğrulanmış Alıcı Rozeti",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Müşteri Yorumları",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "Titanyum standın ağırlığı, mikron hassasiyeti ve dokunsal hissi bugüne kadar sahip olduğum tüm aksesuarların çok ötesinde. Masamda adeta mimari bir heykel gibi duruyor.",
            "author": "Caner V.",
            "role": "Endüstriyel Tasarımcı, İstanbul",
            "verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Detaylara gösterilen özen olağanüstü. Kutusunu açtığım andan itibaren birinci sınıf bir lüks deneyimi hissettiriyor. Kesinlikle tavsiye ederim.",
            "author": "Selin R.",
            "role": "Kreatif Direktör, İzmir",
            "verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Monolitik titanyum gövde ve manyetik kilit mekanizması kusursuz çalışıyor. Kargo 24 saat içinde kapımdaydı.",
            "author": "Kemal T.",
            "role": "Mimar, Ankara",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
