<section class="section-spacing">
  <div class="container-narrow">
    <div style="margin-bottom: var(--space-xl); text-align: center;">
      <span class="text-uppercase text-accent">Müşteri Hizmetleri</span>
      <h1 class="display-title" style="margin: 0.25rem 0 0.75rem;">{{ page.title | default: 'Doğrudan İletişim & Destek' }}</h1>
      <p style="color: var(--color-text-muted); font-size: 1.125rem; max-width: 540px; margin: 0 auto; line-height: 1.6;">
        Özel sipariş, toplu satış veya destek talepleriniz için ekibimiz hizmetinizdedir.
      </p>
    </div>

    <div style="background: var(--color-surface); padding: clamp(2rem, 4vw, 3.5rem); border-radius: var(--border-radius-lg); border: 1px solid var(--color-border);">
      {% form 'contact' %}
        {%- if form.posted_successfully? -%}
          <div style="color: var(--color-stock-success); font-weight: 600; font-size: 1.125rem; text-align: center; padding: 2rem 0;">
            Mesajınız için teşekkür ederiz. Destek ekibimiz 24 saat içinde yanıt verecektir.
          </div>
        {%- else -%}
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div class="form-group">
              <label class="form-label" for="ContactFormName">İsim</label>
              <input type="text" name="contact[name]" id="ContactFormName" class="form-input" placeholder="Adınız" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="ContactFormEmail">E-posta Adresi</label>
              <input type="email" name="contact[email]" id="ContactFormEmail" class="form-input" placeholder="email@domain.com" required>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="ContactFormInquiry">Konu</label>
            <select name="contact[inquiry_type]" id="ContactFormInquiry" class="form-select">
              <option value="General Concierge">Genel Müşteri Desteği</option>
              <option value="Order & Logistics">Sipariş & Kargo</option>
              <option value="Bespoke / Architectural Commission">Özel Sipariş / Toplu Satış</option>
              <option value="Press & Media Relations">Basın & Medya</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="ContactFormMessage">Mesaj</label>
            <textarea name="contact[body]" id="ContactFormMessage" rows="5" class="form-textarea" placeholder="Size nasıl yardımcı olabiliriz?" required></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top: 1rem;">
            Mesajı Gönder
          </button>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "İletişim Sayfası",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst Başlık", "default": "Müşteri Hizmetleri" },
    { "type": "textarea", "id": "description", "label": "Açıklama", "default": "Özel sipariş, toplu satış veya destek talepleriniz için ekibimiz hizmetinizdedir." },
    { "type": "text", "id": "success_message", "label": "Başarı Mesajı", "default": "Mesajınız için teşekkür ederiz. Destek ekibimiz 24 saat içinde yanıt verecektir." },
    { "type": "text", "id": "submit_btn", "label": "Gönder Butonu Metni", "default": "Mesajı Gönder" },
    { "type": "color", "id": "bg_color", "label": "Arka Plan Rengi", "default": "#FFFFFF" },
    { "type": "color", "id": "form_bg_color", "label": "Form Arka Plan Rengi", "default": "#F8F9FA" },
    { "type": "color", "id": "text_color", "label": "Metin Rengi", "default": "#0B0C10" },
    { "type": "color", "id": "btn_bg_color", "label": "Buton Arka Plan Rengi", "default": "#0B0C10" },
    { "type": "color", "id": "btn_text_color", "label": "Buton Metin Rengi", "default": "#FFFFFF" }
  ]
}
{% endschema %}
