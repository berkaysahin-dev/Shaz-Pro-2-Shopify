<section class="section-spacing" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="showcase-grid">
      <!-- Media View -->
      <div class="showcase-media" data-reveal="fade-up">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- else -%}
          <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #11141A 0%, #1A1F2B 100%); display: flex; align-items: center; justify-content: center; color: #475569; padding: 3rem; border-radius: var(--border-radius-lg);">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

      <!-- Tech Specs & Details -->
      <div style="display: flex; flex-direction: column; gap: var(--space-md);" data-reveal="fade-up">
        {%- if section.settings.badge != blank -%}
          <span class="badge badge-new" style="align-self: flex-start;">{{ section.settings.badge }}</span>
        {%- endif -%}

        <h2 class="h2">{{ section.settings.heading | default: 'Tavizsiz Mikro Toleranslar.' }}</h2>

        <p style="color: var(--color-text-muted); font-size: 1.0625rem; line-height: 1.7;">
          {{ section.settings.description | default: 'Yekpare 5. seviye titanyum külçeden CNC ile işlenen her bir yüzey ve kavis, 0.02 mm mikroskobik hassasiyetle el işçiliğiyle tamamlanmıştır.' }}
        </p>

        <!-- Technical Specification Matrix -->
        <div class="showcase-specs">
          <div class="showcase-spec-item">
            <div class="showcase-spec-item__value">{{ section.settings.spec_1_val | default: 'Grade 5' }}</div>
            <div class="showcase-spec-item__label">{{ section.settings.spec_1_label | default: 'Havacılık Titanyumu' }}</div>
          </div>
          <div class="showcase-spec-item">
            <div class="showcase-spec-item__value">{{ section.settings.spec_2_val | default: '0.02 mm' }}</div>
            <div class="showcase-spec-item__label">{{ section.settings.spec_2_label | default: 'CNC İşleme Hassasiyeti' }}</div>
          </div>
          <div class="showcase-spec-item">
            <div class="showcase-spec-item__value">{{ section.settings.spec_3_val | default: '%100' }}</div>
            <div class="showcase-spec-item__label">{{ section.settings.spec_3_label | default: 'Geri Dönüştürülebilir Kutu' }}</div>
          </div>
          <div class="showcase-spec-item">
            <div class="showcase-spec-item__value">{{ section.settings.spec_4_val | default: 'Ömür Boyu' }}</div>
            <div class="showcase-spec-item__label">{{ section.settings.spec_4_label | default: 'Yapısal Garanti' }}</div>
          </div>
        </div>

        {%- if section.settings.cta_text != blank -%}
          <div style="margin-top: 1rem;">
            <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn-primary btn-lg">
              {{ section.settings.cta_text }} →
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ürün Tanıtım Vitrini",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Tanıtım Görseli"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Rozet Metni",
      "default": "Mühendislik Odağı"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Tavizsiz Mikro Toleranslar."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Açıklama",
      "default": "Yekpare 5. seviye titanyum külçeden CNC ile işlenen her bir yüzey ve kavis, 0.02 mm mikroskobik hassasiyetle el işçiliğiyle tamamlanmıştır."
    },
    {
      "type": "text",
      "id": "spec_1_val",
      "label": "1. Değer",
      "default": "Grade 5"
    },
    {
      "type": "text",
      "id": "spec_1_label",
      "label": "1. Etiket",
      "default": "Havacılık Titanyumu"
    },
    {
      "type": "text",
      "id": "spec_2_val",
      "label": "2. Değer",
      "default": "0.02 mm"
    },
    {
      "type": "text",
      "id": "spec_2_label",
      "label": "2. Etiket",
      "default": "CNC İşleme Hassasiyeti"
    },
    {
      "type": "text",
      "id": "spec_3_val",
      "label": "3. Değer",
      "default": "%100"
    },
    {
      "type": "text",
      "id": "spec_3_label",
      "label": "3. Etiket",
      "default": "Geri Dönüştürülebilir Kutu"
    },
    {
      "type": "text",
      "id": "spec_4_val",
      "label": "4. Değer",
      "default": "Ömür Boyu"
    },
    {
      "type": "text",
      "id": "spec_4_label",
      "label": "4. Etiket",
      "default": "Yapısal Garanti"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Buton Metni",
      "default": "Ürünü Satın Al"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Buton Linki"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Ürün Tanıtım Vitrini"
    }
  ]
}
{% endschema %}
