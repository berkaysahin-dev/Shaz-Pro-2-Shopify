<section class="marquee-ticker" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="marquee-ticker__track" style="animation-direction: {{ section.settings.direction }}; animation-duration: {{ section.settings.speed }}s;">
    {%- for i in (1..4) -%}
      {%- for block in section.blocks -%}
        <div class="marquee-ticker__item" {{ block.shopify_attributes }}>
          <span>{{ block.settings.text }}</span>
          <span class="marquee-ticker__dot">{{ section.settings.divider | default: '✦' }}</span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Kayan Metin",
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "Kayma Yönü",
      "options": [
        { "value": "normal", "label": "Soldan Sağa" },
        { "value": "reverse", "label": "Sağdan Sola" }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Animasyon Hızı (Süre)",
      "default": 24
    },
    {
      "type": "text",
      "id": "divider",
      "label": "Ayırıcı Sembol",
      "default": "✦"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#0F1115"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Yazı Rengi",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "marquee_item",
      "name": "Kayan Metin Öğesi",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Vurgu Metni",
          "default": "SHAZ AGENCY — FORM / FONKSİYON / GELECEK"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kayan Metin",
      "blocks": [
        { "type": "marquee_item", "settings": { "text": "SHAZ AGENCY — FORM / FONKSİYON / GELECEK" } },
        { "type": "marquee_item", "settings": { "text": "HAVACILIK SINIFI 5. SEVİYE TİTANYUM BLOK" } },
        { "type": "marquee_item", "settings": { "text": "AYNI GÜN ÜCRETSİZ VIP EXPRESS KARGO" } },
        { "type": "marquee_item", "settings": { "text": "0.02 MM CNC MİKRO HASSASİYET" } },
        { "type": "marquee_item", "settings": { "text": "%100 ÖMÜR BOYU YAPISAL GARANTİ" } }
      ]
    }
  ]
}
{% endschema %}
