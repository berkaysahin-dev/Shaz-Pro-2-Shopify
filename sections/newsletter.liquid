<section class="section-spacing" style="background-color: {{ section.settings.bg_color }};">
  <div class="container-narrow">
    <div style="text-align: center; display: flex; flex-direction: column; gap: 1rem; align-items: center; background: var(--color-surface); padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 3.5rem); border-radius: var(--border-radius-lg); border: 1px solid var(--color-border);">
      <span class="text-uppercase text-accent">{{ section.settings.badge | default: 'Shaz Pro VIP Bülteni' }}</span>
      <h2 class="h1" style="font-size: clamp(2rem, 1.5rem + 1.5vw, 3rem);">
        {{ section.settings.title | default: 'Shaz Pro Kulübüne Katılın' }}
      </h2>
      <p style="color: var(--color-text-muted); font-size: 1.0625rem; max-width: 500px; line-height: 1.6;">
        {{ section.settings.subtitle | default: 'Özel lansman davetiyeleri, sınırlı üretim duyuruları ve teknik tasarım bültenleri alın. Gizliliğinize saygı duyuyoruz.' }}
      </p>

      {% form 'customer', class: 'newsletter-form', style: 'width: 100%; max-width: 440px; margin-top: 1rem;' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <div style="color: var(--color-stock-success); font-weight: 600; font-size: 14px;">
            {{ 'general.newsletter.success' | t | default: 'Bültenimize kaydoldunuz. Shaz Pro ayrıcalıklar dünyasına hoş geldiniz.' }}
          </div>
        {%- else -%}
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <input
              type="email"
              name="contact[email]"
              class="form-input"
              placeholder="{{ 'general.newsletter.placeholder' | t | default: 'E-posta adresinizi girin' }}"
              required
              style="flex: 1; min-width: 220px; height: 48px;"
            >
            <button type="submit" class="btn btn-primary" style="height: 48px; min-width: 130px;">
              {{ 'general.newsletter.button' | t | default: 'Kayıt Ol' }}
            </button>
          </div>
          {%- if form.errors -%}
            <div style="color: var(--color-sale); font-size: 12px; margin-top: 0.5rem;">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </div>
          {%- endif -%}
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Posta Bülteni",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Üst Rozet",
      "default": "Shaz Pro VIP Bülteni"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Başlık",
      "default": "Shaz Pro Kulübüne Katılın"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Açıklama",
      "default": "Özel lansman davetiyeleri, sınırlı üretim duyuruları ve teknik tasarım bültenleri alın. Gizliliğinize saygı duyuyoruz."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "E-Posta Bülteni"
    }
  ]
}
{% endschema %}
