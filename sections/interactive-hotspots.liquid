<section class="section-spacing" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="section-header text-center" data-reveal="fade-up">
      {%- if section.settings.subtitle != blank -%}
        <div class="section-subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      <h2 class="h2">{{ section.settings.title | default: 'İnteraktif Ürün Anatomisi' }}</h2>
    </div>

    <div class="hotspot-container" data-reveal="fade-up">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.title | escape }}" loading="lazy" style="width: 100%; height: auto; display: block;">
      {%- else -%}
        <img src="https://images.unsplash.com/photo-1507473885765-e6ed057f782c?q=80&w=1600&auto=format&fit=crop" alt="Shaz Pro Mekânsal Stand" loading="lazy" style="width: 100%; height: auto; display: block; aspect-ratio: 16/9; object-fit: cover;">
      {%- endif -%}

      <!-- Hotspot Points -->
      {%- for block in section.blocks -%}
        {%- assign hotspot_product = all_products[block.settings.product] -%}
        <div class="hotspot-point" style="top: {{ block.settings.pos_y }}%; left: {{ block.settings.pos_x }}%;" {{ block.shopify_attributes }}>
          <span>+</span>

          <div class="hotspot-tooltip">
            <div style="font-weight: 600; font-size: 13px; margin-bottom: 0.25rem;">
              {{ hotspot_product.title | default: block.settings.title | default: 'N52 Manyetik Kilit Alanı' }}
            </div>
            <div style="font-size: 12px; color: var(--color-text-muted); margin-bottom: 0.5rem;">
              {{ hotspot_product.price | money | default: '2.400 ₺' }}
            </div>
            <a href="{{ hotspot_product.url | default: '/collections/all' }}" class="btn btn-primary btn-sm btn-full" style="padding: 0.35rem 0.5rem; font-size: 11px;">
              Detayı İncele →
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "İnteraktif Ürün Noktaları",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Ana Sahne Görseli"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Alt Başlık",
      "default": "İnteraktif İnceleme"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Başlık",
      "default": "Detaylı Mimari İnceleme"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "İnteraktif Nokta (Hotspot)",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Etiketli Ürün (İsteğe bağlı)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nokta Başlığı",
          "default": "N52 Manyetik Kilit Alanı"
        },
        {
          "type": "range",
          "id": "pos_x",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Yatay Konum (X)",
          "default": 35
        },
        {
          "type": "range",
          "id": "pos_y",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Dikey Konum (Y)",
          "default": 45
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "İnteraktif Ürün Noktaları",
      "blocks": [
        {
          "type": "hotspot",
          "settings": { "title": "N52 Manyetik Kilit Alanı", "pos_x": 38, "pos_y": 42 }
        },
        {
          "type": "hotspot",
          "settings": { "title": "Akustik Silikon Ped Taban", "pos_x": 62, "pos_y": 68 }
        }
      ]
    }
  ]
}
{% endschema %}
