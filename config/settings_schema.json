      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Arka Plan Rengi",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Yüzey / Kart Rengi",
        "default": "#F8F9FA"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Kenarlık Rengi",
        "default": "#E2E8F0"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Metin Rengi",
        "default": "#0B0C10"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Soluk Metin Rengi",
        "default": "#64748B"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "İndirim / Hata Rengi",
        "default": "#DC2626"
