      },
      {
        "type": "color",
        "id": "color_button_bg",
        "label": "Buton Arka Planı",
        "default": "#0B0C10"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Buton Metni",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Tipografi",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Başlık Fontu",
        "default": "helvetica_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Gövde Fontu",
        "default": "helvetica_n4"
      },
      {
        "type": "range",
        "id": "font_base_size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Temel Font Boyutu",
        "default": 16
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "min": 85,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Gövde Fontu Ölçeği",
        "default": 100
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "min": 85,
        "max": 140,
        "step": 5,
        "unit": "%",
        "label": "Başlık Fontu Ölçeği",
        "default": 100
      },
      {
        "type": "select",
        "id": "heading_letter_spacing",
        "label": "Başlık Harf Aralığı",
        "options": [
          {
            "value": "-0.04em",
            "label": "Sıkı (-0.04em)"
          },
          {
            "value": "-0.02em",
            "label": "Modern (-0.02em)"
          },
          {
            "value": "0",
            "label": "Normal (0)"
          },
          {
            "value": "0.05em",
            "label": "Geniş (0.05em)"
          }
        ],
        "default": "-0.02em"
      }
    ]
  },
  {
    "name": "Düzen & Stil",
    "settings": [
      {
        "type": "range",
        "id": "container_max_width",
        "min": 1200,
        "max": 1680,
        "step": 40,
        "unit": "px",
        "label": "Maksimum Kapsayıcı Genişliği",
        "default": 1440
      },
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Genel Kenar Yuvarlaklığı",
        "default": 6
      },
      {
        "type": "select",
        "id": "shadow_style",
        "label": "Gölge Stili",
        "options": [
          {
            "value": "none",
            "label": "Yok / Düz"
          },
          {
            "value": "subtle",
            "label": "Hafif"
          },
          {
            "value": "elevated",
            "label": "Belirgin"
          }
        ],
        "default": "subtle"
      },
      {
        "type": "checkbox",
        "id": "enable_micro_animations",
        "label": "Mikro Etkileşimleri ve Vurgu Dinamiklerini Etkinleştir",
        "default": true
      }
    ]
  },
  {
    "name": "Ürün Kartı",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Görsel Oranı",
        "options": [
          {
            "value": "portrait",
            "label": "Dikey (3:4)"
          },
          {
            "value": "square",
            "label": "Kare (1:1)"
          },
          {
            "value": "landscape",
            "label": "Yatay (4:3)"
          }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Üzerine Gelince İkinci Görseli Göster",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Satıcıyı Göster",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Değerlendirmeyi Göster",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Hızlı Eklemeyi Göster",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_view",
        "label": "Hızlı Görünümü Göster",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_wishlist",
        "label": "Favoriler Butonunu Göster",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Renk Seçeneklerini (Swatches) Göster",
        "default": true
      }
    ]
  },
  {
    "name": "Sepet & Kargo",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Sepet Deneyimi",
        "options": [
          {
            "value": "drawer",
            "label": "Çekmece Sepet"
          },
          {
            "value": "page",
            "label": "Standart Sepet Sayfası"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "Ücretsiz Kargo Limiti",
        "default": 150
      },
      {
        "type": "checkbox",
        "id": "cart_enable_free_shipping_bar",
        "label": "Ücretsiz Kargo Barını Etkinleştir",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_free_shipping_message",
        "label": "Ücretsiz Kargo İlerleme Mesajı",
        "default": "Ücretsiz kargoya ulaşmak için [amount] daha ekleyin"
      },
      {
        "type": "text",
        "id": "cart_free_shipping_unlocked_message",
        "label": "Ücretsiz Kargo Kazanıldı Mesajı",
        "default": "🎉 Tebrikler! Ücretsiz kargo kazandınız."
      },
      {
        "type": "checkbox",
        "id": "cart_enable_upsells",
        "label": "Sepet İçi Çapraz Satış (Upsell) Etkinleştir",
        "default": true
      },
      {
        "type": "collection",
        "id": "cart_upsell_collection",
        "label": "Upsell Koleksiyonu"
      },
      {
        "type": "checkbox",
        "id": "cart_show_notes",
        "label": "Sipariş Notu / Hediye Mesajını Etkinleştir",
        "default": true
      }
    ]
  },
  {
    "name": "Ürün Sayfası (PDP) Dönüşümleri",
    "settings": [
      {
        "type": "checkbox",
        "id": "pdp_enable_sticky_atc",
        "label": "Kaydırırken Yapışkan Sepete Ekle Barını Etkinleştir",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "pdp_enable_live_stock",
        "label": "Stok Azlığı Göstergesini Etkinleştir",
        "default": true
      },
      {
        "type": "number",
        "id": "pdp_stock_threshold",
        "label": "Stok Aciliyeti Eşiği",
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "pdp_enable_delivery_estimator",
        "label": "Gerçek Zamanlı Teslimat Tahmini Göster",
        "default": true
      },
      {
        "type": "text",
        "id": "pdp_delivery_days_range",
        "label": "Tahmini Teslimat Süresi",
        "default": "2-4 İş Günü"
      },
      {
        "type": "checkbox",
        "id": "pdp_enable_trust_badges",
        "label": "Güven ve Ödeme Rozetlerini Göster",
        "default": true
      },
      {
        "type": "color",
        "id": "pdp_shipping_badge_bg",
        "label": "Hızlı Kargo Rozeti Arka Planı",
        "default": "#F0FDF4"
      },
      {
        "type": "color",
        "id": "pdp_shipping_badge_text",
        "label": "Hızlı Kargo Rozeti Metni",
        "default": "#166534"
      },
      {
        "type": "color",
        "id": "pdp_shipping_badge_border",
        "label": "Hızlı Kargo Rozeti Kenarlığı",
        "default": "#BBF7D0"
      },
      {
        "type": "color",
        "id": "pdp_stock_pulse_color",
        "label": "Canlı Stok Vurgu Rengi",
        "default": "#E11D48"
      },
      {
        "type": "color",
        "id": "pdp_stock_text_color",
        "label": "Stok Aciliyeti Metin Rengi",
        "default": "#111827"
      }
    ]
  },
  {
    "name": "Sosyal Medya",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram Bağlantısı",
        "default": "https://instagram.com"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X (Twitter) Bağlantısı",
